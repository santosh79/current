{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://current.internal/schema/proposal_response.schema.json",
  "title": "Proposal response",
  "description": "The wire shape an agent (LLM) must return when asked to produce a proposal. Every path in it is relative to the project root. See docs/wire_schema.md for the human-readable version of this same contract -- keep the two in sync.",
  "type": "object",
  "required": [
    "intents"
  ],
  "properties": {
    "justification": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/intent"
      }
    }
  },
  "definitions": {
    "intent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "description": "Arbitrary caller-chosen name for this intent, resolvable later via a claim's evidence.source_intent_ref. Meaningful only within this one response, and must be unique within it."
        },
        "type": {
          "type": "string",
          "enum": [
            "read_file",
            "write_file",
            "delete_file",
            "file_patch",
            "run_command",
            "grep",
            "glob",
            "claim",
            "report"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/intent_fields_by_type"
        }
      ]
    },
    "intent_fields_by_type": {
      "if": {
        "properties": {
          "type": {
            "const": "read_file"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/read_file"
      },
      "else": {
        "if": {
          "properties": {
            "type": {
              "const": "write_file"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/write_file"
        },
        "else": {
          "if": {
            "properties": {
              "type": {
                "const": "delete_file"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/delete_file"
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "file_patch"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/file_patch"
            },
            "else": {
              "if": {
                "properties": {
                  "type": {
                    "const": "run_command"
                  }
                }
              },
              "then": {
                "$ref": "#/definitions/run_command"
              },
              "else": {
                "if": {
                  "properties": {
                    "type": {
                      "const": "grep"
                    }
                  }
                },
                "then": {
                  "$ref": "#/definitions/grep"
                },
                "else": {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "glob"
                      }
                    }
                  },
                  "then": {
                    "$ref": "#/definitions/glob"
                  },
                  "else": {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "claim"
                        }
                      }
                    },
                    "then": {
                      "$ref": "#/definitions/claim"
                    },
                    "else": {
                      "if": {
                        "properties": {
                          "type": {
                            "const": "report"
                          }
                        }
                      },
                      "then": {
                        "$ref": "#/definitions/report"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "read_file": {
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project.",
          "type": "string"
        }
      }
    },
    "write_file": {
      "description": "Creates a new file. Fails when applied if the file already exists -- change an existing file with file_patch.",
      "required": [
        "path",
        "contents"
      ],
      "properties": {
        "path": {
          "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project.",
          "type": "string"
        },
        "contents": {
          "description": "The complete contents of the new file.",
          "type": "string"
        }
      }
    },
    "delete_file": {
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project.",
          "type": "string"
        }
      }
    },
    "file_patch": {
      "description": "Changes an existing file.",
      "required": [
        "path",
        "diff"
      ],
      "properties": {
        "path": {
          "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project.",
          "type": "string"
        },
        "diff": {
          "description": "A unified diff of this one file -- the format `diff -u` produces -- applied with exactly `patch --batch --forward --fuzz=0 <path> <diff>`. Hunk headers (\"@@ -old_start,old_count +new_start,new_count @@\") need exact line counts, and context and removed lines must match the current file exactly. The ---/+++ file names are ignored; the target is `path`. Other patch formats (e.g. \"*** Begin Patch\") are rejected.",
          "type": "string"
        }
      }
    },
    "run_command": {
      "required": [
        "cmd"
      ],
      "properties": {
        "cmd": {
          "description": "An executable name, run in the project root with `args`. Not a shell: no pipes, redirects or globbing.",
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grep": {
      "required": [
        "pattern",
        "paths"
      ],
      "properties": {
        "pattern": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project.",
            "type": "string"
          }
        }
      }
    },
    "glob": {
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "description": "A relative glob pattern, e.g. \"**/*.ex\".",
          "type": "string"
        },
        "base_dir": {
          "description": "Relative to the project root, e.g. \"lib/signup.ex\". Must not contain \"..\" and must stay inside the project. Defaults to \".\".",
          "type": "string"
        }
      }
    },
    "claim": {
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/claim_evidence"
        }
      }
    },
    "claim_evidence": {
      "type": "object",
      "required": [
        "source_intent_ref",
        "condition",
        "value"
      ],
      "properties": {
        "source_intent_ref": {
          "type": "string"
        },
        "condition": {
          "type": "string",
          "enum": [
            "match_count_greater_than",
            "match_count_equals",
            "exit_code_equals"
          ]
        },
        "value": {}
      }
    },
    "report": {
      "properties": {
        "summary": {
          "type": "string"
        }
      }
    }
  }
}

