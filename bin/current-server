#!/usr/bin/env sh
# Starts the long-running Current runtime as a named Erlang node, which
# the `current` CLI connects to. CURRENT_NODE overrides the node name
# (the CLI reads the same variable).
#
# Activity (RPC requests and WAL commits) is printed to this console;
# CURRENT_ACTIVITY_LOG=false turns it off.
#
# Ctrl-C stops the runtime gracefully (the WAL is closed cleanly),
# instead of opening Erlang's BREAK menu.
set -e
cd "$(dirname "$0")/.."

# +Bi: the VM ignores Ctrl-C itself; this script turns it into a SIGTERM,
# which the VM handles as a graceful shutdown.
# -current activity_log: set before the application starts, so commits
# made while resuming in-flight workflows at boot are printed too.
elixir --sname "${CURRENT_NODE:-current@localhost}" \
  --erl "+Bi -current activity_log ${CURRENT_ACTIVITY_LOG:-true}" \
  -S mix run --no-halt -e '
h = Current.RPC.status()

IO.puts("""

Current #{h.version}
runtime ready
node      #{h.node}
WAL       #{h.wal_path}
WAL head  ##{h.wal_head}
builder   #{inspect(h.proposal_builder)}
activity  #{if Application.get_env(:current, :activity_log), do: "on", else: "off"}

Ctrl-C to stop.
""")
' &
pid=$!

trap 'echo; echo "stopping..."; kill -TERM "$pid" 2>/dev/null || true' INT TERM

# wait returns early when a trapped signal arrives; keep waiting until
# the runtime has actually exited.
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid" || true
done
echo "stopped"
